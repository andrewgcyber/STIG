# STIG Remediation
# Enables: "Turn off printing over HTTP"
#
# Registry Hive: HKEY_LOCAL_MACHINE
# Registry Path: SOFTWARE\Policies\Microsoft\Windows NT\Printers
# Value Name: DisableHTTPPrinting
# Value Type: REG_DWORD
# Required Value: 1

#Requires -RunAsAdministrator

$ErrorActionPreference = "Stop"

$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Printers"
$ValueName    = "DisableHTTPPrinting"
$RequiredValue = 1

try {
    Write-Host "Configuring HTTP printing policy..." -ForegroundColor Yellow

    # Create the registry path if it does not exist
    if (-not (Test-Path -LiteralPath $RegistryPath)) {
        New-Item -Path $RegistryPath -Force | Out-Null
    }

    # Create or update the required REG_DWORD value
    New-ItemProperty `
        -Path $RegistryPath `
        -Name $ValueName `
        -PropertyType DWord `
        -Value $RequiredValue `
        -Force | Out-Null

    # Verify remediation
    $CurrentValue = Get-ItemPropertyValue `
        -Path $RegistryPath `
        -Name $ValueName

    if ($CurrentValue -eq $RequiredValue) {
        Write-Host "`nRemediation successful." -ForegroundColor Green
        Write-Host "$ValueName is configured as REG_DWORD value $CurrentValue."
        exit 0
    }

    throw "Verification failed. Expected $RequiredValue but found $CurrentValue."
}
catch {
    Write-Error "Remediation failed: $($_.Exception.Message)"
    exit 1
}

