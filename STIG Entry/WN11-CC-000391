<#
.SYNOPSIS
    This stig ensures that Internet Explorer is disabled for Windows 11
.NOTES
    Author          : Andrew Gay
    LinkedIn        : linkedin.com/in/andrewgaytech/
    GitHub          : github.com/andrewgcyber
    Date Created    : 2026-07-31
    Last Modified   : 2026-07-31
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000391
    Documentation   : https://stigaview.com/products/win11/v1r5/WN11-CC-000391/

.TESTED ON
    Date(s) Tested  : 
    Tested By       : 
    Systems Tested  : 
    PowerShell Ver. : 

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\__remediation_template(STIG-ID-WN10-AU-000500).ps1 
#>
#Requires -RunAsAdministrator

<#
STIG Remediation:
Allow indexing of encrypted files = Disabled

Registry:
HKLM\SOFTWARE\Policies\Microsoft\Windows\Windows Search
AllowIndexingEncryptedStoresOrItems = 0
#>

$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Windows Search"
$ValueName    = "AllowIndexingEncryptedStoresOrItems"
$RequiredValue = 0

try {
    # Create the registry path if it does not exist
    if (-not (Test-Path $RegistryPath)) {
        New-Item -Path $RegistryPath -Force | Out-Null
    }

    # Create or update the DWORD value
    New-ItemProperty `
        -Path $RegistryPath `
        -Name $ValueName `
        -PropertyType DWord `
        -Value $RequiredValue `
        -Force | Out-Null

    # Refresh computer policy
    gpupdate.exe /target:computer /force | Out-Null

    # Verify the setting
    $CurrentValue = Get-ItemPropertyValue `
        -Path $RegistryPath `
        -Name $ValueName `
        -ErrorAction Stop

    if ($CurrentValue -eq $RequiredValue) {
        Write-Host "STIG remediation successful." -ForegroundColor Green
        Write-Host "Registry Path: $RegistryPath"
        Write-Host "Value Name: $ValueName"
        Write-Host "Value: $CurrentValue"
        Write-Host 'Policy status: "Allow indexing of encrypted files" is Disabled.'
        exit 0
    }
    else {
        throw "Verification failed. Current value is '$CurrentValue'; expected '$RequiredValue'."
    }
}
catch {
    Write-Host "STIG remediation failed: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}
