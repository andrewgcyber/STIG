<#
.SYNOPSIS
    This STIG remediation is to ensure that Windows 11 is configured to disable Windows Game Recording and Broadcasting
.NOTES
    Author          : Andrew Gay
    LinkedIn        : linkedin.com/in/andrewgaytech/
    GitHub          : github.com/andrewgcyber
    Date Created    : 2026-07-31
    Last Modified   : 2026-07-31
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000252
    Documentation   : https://stigaview.com/products/win11/v2r1/WN11-CC-000252/

.TESTED ON
    Date(s) Tested  : 
    Tested By       : 
    Systems Tested  : 
    PowerShell Ver. : 

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\__remediation_template(STIG-ID-WN10-AU-000500).ps1 
#>

# ============================================================
# STIG ID: WN11-CC-000252
# Title: Disable Windows Game Recording and Broadcasting
#
# Required setting:
# HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR
# AllowGameDVR = 0 (REG_DWORD)
# ============================================================

$RegistryPath  = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\GameDVR"
$ValueName     = "AllowGameDVR"
$RequiredValue = 0

# Verify the script is running with administrative privileges
$CurrentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
$Principal = New-Object Security.Principal.WindowsPrincipal($CurrentIdentity)

if (-not $Principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {
    Write-Error "This script must be run as Administrator."
    exit 1
}

try {
    # Create the registry path if it does not already exist
    New-Item -Path $RegistryPath -Force -ErrorAction Stop | Out-Null

    # Create or update the required policy value
    New-ItemProperty `
        -Path $RegistryPath `
        -Name $ValueName `
        -PropertyType DWord `
        -Value $RequiredValue `
        -Force `
        -ErrorAction Stop | Out-Null

    # Refresh computer Group Policy
    Start-Process `
        -FilePath "gpupdate.exe" `
        -ArgumentList "/target:computer /force" `
        -Wait `
        -NoNewWindow

    # Verify the configured value
    $ConfiguredValue = Get-ItemPropertyValue `
        -Path $RegistryPath `
        -Name $ValueName `
        -ErrorAction Stop

    if ($ConfiguredValue -eq $RequiredValue) {
        Write-Host ""
        Write-Host "PASS: WN11-CC-000252 has been remediated." `
            -ForegroundColor Green
        Write-Host "Registry setting:"
        Write-Host "HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR"
        Write-Host "AllowGameDVR = $ConfiguredValue (REG_DWORD)"
        exit 0
    }
    else {
        Write-Error "Remediation failed. AllowGameDVR is set to $ConfiguredValue."
        exit 1
    }
}
catch {
    Write-Error "Unable to remediate WN11-CC-000252: $($_.Exception.Message)"
    exit 1
}
