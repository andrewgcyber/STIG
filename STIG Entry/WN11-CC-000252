# STIG Remediation:
# Disable Windows Game Recording and Broadcasting

$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\GameDVR"
$ValueName = "AllowGameDVR"
$ValueData = 0

# Create the registry path if it doesn't exist
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Create or update the registry value
New-ItemProperty `
    -Path $RegistryPath `
    -Name $ValueName `
    -PropertyType DWord `
    -Value $ValueData `
    -Force | Out-Null

# Refresh Group Policy
gpupdate /force | Out-Null

Write-Host "STIG remediated successfully." -ForegroundColor Green
Write-Host "Windows Game Recording and Broadcasting has been Disabled."

# Verify the setting
Get-ItemProperty -Path $RegistryPath -Name $ValueName
